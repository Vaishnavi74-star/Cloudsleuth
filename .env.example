# CloudSleuth Gemma Integration Environment Configuration
# Copy this file to .env and configure your credentials.

# Google AI Studio / Gemma API Key (Free tier available at https://aistudio.google.com/)
GEMMA_API_KEY=your_google_ai_studio_api_key_here

# Optional: Gemma Model ID (e.g., gemma-4-26b-a4b-it, gemma-2-27b-it, gemini-2.5-flash)
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional: Alternative inference providers
# If using Groq (free tier with gemma2-9b-it):
# GROQ_API_KEY=your_groq_api_key_here

# If using local Ollama (e.g., ollama run gemma2:9b):
# GEMMA_API_BASE=http://localhost:11434
